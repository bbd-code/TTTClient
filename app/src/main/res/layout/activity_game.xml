<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.bbd.tttclient.activities.GameActivity">

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/uiCellsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cell1"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="0"
            app:layout_row="0" />

        <ImageButton
            android:id="@+id/cell2"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="1"
            app:layout_row="0" />

        <ImageButton
            android:id="@+id/cell3"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="2"
            app:layout_row="0" />

        <ImageButton
            android:id="@+id/cell4"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="0"
            app:layout_row="1" />

        <ImageButton
            android:id="@+id/cell5"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="1"
            app:layout_row="1" />

        <ImageButton
            android:id="@+id/cell6"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="2"
            app:layout_row="1" />

        <ImageButton
            android:id="@+id/cell7"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="0"
            app:layout_row="2" />

        <ImageButton
            android:id="@+id/cell8"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="1"
            app:layout_row="2" />

        <ImageButton
            android:id="@+id/cell9"
            android:layout_width="136dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/dark_green"
            android:contentDescription="@string/cell"
            android:scaleType="fitCenter"
            app:layout_column="2"
            app:layout_row="2" />

    </androidx.gridlayout.widget.GridLayout>

    <TextView
        android:id="@+id/gameStateTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="160dp"
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf="@id/uiCellsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/restartGameButton"
        android:layout_width="184dp"
        android:layout_height="90dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="97dp"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="81dp"
        android:backgroundTint="@color/dark_green"
        android:text="@string/restart"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/uiCellsLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>