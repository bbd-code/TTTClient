<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_icon2"
        android:label="@string/app_name"
        android:minSdkVersion="26"
        android:roundIcon="@drawable/app_icon2"
        android:screenOrientation="portrait"
        android:supportsRtl="true"
        android:theme="@style/Theme.TTTClient"
        android:usesCleartextTraffic="true"
        tools:ignore="DiscouragedApi">
        <activity
            android:name="com.bbd.tttclient.activities.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.bbd.tttclient.activities.GameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            >

        </activity>
        <activity
            android:name="com.bbd.tttclient.activities.LobbyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            />
    </application>

</manifest>